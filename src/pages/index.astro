---
import Hero from '../components/Hero.astro'
import Layout from '../layouts/Layout.astro';
import BackgroundCard from '../components/BackgroundCard.astro';

const spotlightCode = `background:
  radial-gradient(circle at 50% 35%, rgba(223, 182, 92, 0.35), transparent 32%),
  radial-gradient(circle at 50% 35%, rgba(180, 151, 214, 0.18), transparent 55%);`;
---

<Layout>
	<Hero />
	<main class="gallery-grid" id="gallery">
		<BackgroundCard title="Radial Spotlight" code={spotlightCode}>
  			<div class="spotlight-demo"></div>
		</BackgroundCard>

	</main>
</Layout>

<style>
	main {
		width: 60%;
		margin: 0 auto;
        scroll-margin-top: 2rem;
	}
</style>
