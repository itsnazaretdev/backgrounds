---
const { title, background, theme, tailwind } = Astro.props;

const code = `background: ${background};`;
---

<article class="background-card reveal" data-theme={theme}>
  <div class="preview" style={`background: ${background};`}></div>

  <div class="card-content">
    <h2>{title}</h2>

    <div class="card-actions">
      <button
        class="preview-button"
        type="button"
        data-preview
        data-title={title}
        data-background={background}
        data-theme={theme}
      >
        Preview
      </button>

      <button
        class="copy-button"
        type="button"
        data-code={code}
      >
        CSS
      </button>

      <button
        class="copy-button"
        type="button"
        data-code={tailwind}
      >
        Tailwind
      </button>
    </div>
  </div>
</article>

<style>
  .background-card {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-text-muted);
    border-radius: 1rem;
    background: var(--color-background);
  }

  .preview {
    aspect-ratio: 16 / 10;
  }

  .card-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .card-content h2 {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--color-text);
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .preview-button,
  .copy-button {
    border: 0;
    padding: 0;
    background: none;
    color: var(--color-text-muted);
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .preview-button:hover,
  .copy-button:hover {
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .card-content {
      align-items: flex-start;
      flex-direction: column;
    }

    .card-actions {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll('.copy-button');

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.getAttribute('data-code');

      if (!code) return;

      await navigator.clipboard.writeText(code);

      const originalText = button.textContent;

      button.textContent = 'Copied!';

      setTimeout(() => {
        button.textContent = originalText;
      }, 1500);
    });
  });
</script>